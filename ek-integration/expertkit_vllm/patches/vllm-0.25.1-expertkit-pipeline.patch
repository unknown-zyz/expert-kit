+def _profile_attention_forward(forward):
+    """Associate Attention launch APIs with layer/uBatch NVTX metadata."""
+
+    @wraps(forward)
+    def wrapped(self, *args, **kwargs):
+        if os.getenv("EK_NSYS_PROFILE", "0") != "1":
+            return forward(self, *args, **kwargs)
+        label = (
+            f"EK:A:u={dbo_current_ubatch_id()}:l={self.layer_idx}"
+        )
+        torch.cuda.nvtx.range_push(label)
+        try:
+            return forward(self, *args, **kwargs)
+        finally:
+            torch.cuda.nvtx.range_pop()
+
+    return wrapped
+
