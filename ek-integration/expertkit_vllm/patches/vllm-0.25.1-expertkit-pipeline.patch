+class UBatchCoordinator:
+    """Completion-driven single-runner scheduler for uBatch threads.
+
+    vLLM's forward context is process-global, so at most one Python model
+    thread may run at a time. Unlike the original ring, this coordinator can
+    leave an uBatch blocked on an external Future and schedule whichever
+    uBatch becomes ready first.
+    """
+
+    def __init__(self, num_ubatches: int):
+        self._condition = threading.Condition()
+        self._ready = deque(range(num_ubatches))
+        self._ready_set = set(range(num_ubatches))
+        self._active: int | None = None
+        self._finished: set[int] = set()
+        self._failure: BaseException | None = None
+
+    def _schedule_locked(self) -> None:
+        if self._active is not None:
+            return
+        while self._ready:
+            candidate = self._ready.popleft()
+            self._ready_set.discard(candidate)
+            if candidate not in self._finished:
+                self._active = candidate
+                break
+        self._condition.notify_all()
+
+    def _raise_if_failed_locked(self) -> None:
+        if self._failure is not None:
+            raise UBatchAborted("another uBatch failed") from self._failure
+
+    def enter(self, ubatch_id: int) -> None:
+        with self._condition:
+            self._schedule_locked()
+            while self._active != ubatch_id:
+                self._raise_if_failed_locked()
+                self._condition.wait()
+
+    def yield_(self, ubatch_id: int) -> None:
+        with self._condition:
+            assert self._active == ubatch_id
+            if ubatch_id not in self._ready_set:
+                self._ready.append(ubatch_id)
+                self._ready_set.add(ubatch_id)
+            self._active = None
+            self._schedule_locked()
+            while self._active != ubatch_id:
+                self._raise_if_failed_locked()
+                self._condition.wait()
+
+    def wait_for_future(self, ubatch_id: int, future) -> None:
+        if future.done():
+            return
+
+        def mark_ready(_future) -> None:
+            with self._condition:
+                if (
+                    ubatch_id not in self._finished
+                    and ubatch_id not in self._ready_set
+                    and self._active != ubatch_id
+                ):
+                    self._ready.append(ubatch_id)
+                    self._ready_set.add(ubatch_id)
+                self._schedule_locked()
